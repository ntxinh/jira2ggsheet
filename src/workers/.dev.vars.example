SECRET_TOKEN=change-me-to-a-random-string
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
SPREADSHEET_ID=your-google-sheet-id
JIRA_EMAIL=your-jira-email@example.com
JIRA_API_TOKEN=your-atlassian-api-token

# Plain vars (set in the Cloudflare dashboard for prod; local dev reads them here).
JIRA_SUBDOMAIN=acme
PROJECT_KEY=ABC
TEMPLATE_SHEET=Template
KEY_COLUMN=B
HEADER_ROWS=3
DELETE_MODE=delete
TIMEZONE=Asia/Ho_Chi_Minh
DATE_FORMAT=yyyy-MM-dd HH:mm
CUSTOM_FIELDS_SPRINT=customfield_10016
CUSTOM_FIELDS_STORY_POINTS=customfield_10021
COLUMN_MAP_JSON={"B":"issueKey","C":"issueLink","D":"issueType","E":"priority","F":"summary","G":"status","M":"createdDate","K":"storyPoints","H":"assignee","L":"labels"}
# Comma-separated sprint IDs: the cron syncs each one fully, one after another.
SPRINT_ID=690,691

# SENTRY_DSN=https://PLACEHOLDER_1@PLACEHOLDER_2.ingest.us.sentry.io/PLACEHOLDER_3  # uncomment to enable local Sentry reporting

# GOOGLE_CHAT_WEBHOOK=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=YOUR_KEY&token=YOUR_TOKEN  # uncomment to post a notification to a Chat space per Jira webhook (keep the real URL in .dev.vars, not here)
